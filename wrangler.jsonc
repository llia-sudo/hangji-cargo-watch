{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hangji-cargo-watch",
  "account_id": "9788f37724c6560eed954ee6fa655671",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hangji-cargo-watch",
      "database_id": "3f3f00b9-d852-42d3-926d-0125d97712e0",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
